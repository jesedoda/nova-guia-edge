{
  "manifest_version": 3,
  "name": "__MSG_nome__",
  "short_name": "__MSG_nomeCurto__",
  "description": "__MSG_descricao__",
  "default_locale": "en",
  "version": "1.1.0",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "novaguia.html"
  },
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_tituloAcao__"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": ["storage"]
}
